diff --git a/src/mainboard/nintendo/switch/memlayout.ld b/src/mainboard/nintendo/switch/memlayout.ld
index 90b3b39..7e0f411 100644
--- a/src/mainboard/nintendo/switch/memlayout.ld
+++ b/src/mainboard/nintendo/switch/memlayout.ld
@@ -43,5 +43,10 @@ SECTIONS
 	RAMSTAGE(0x80200000, 256K)
 	REGION(rom_copy, 0xd0000000 - CONFIG_ROM_SIZE, CONFIG_ROM_SIZE, 4)
 	POSTRAM_CBFS_CACHE(0xd0000000, 8M)
+#if ENV_ARM64
 	TTB(0x100000000 - CONFIG_TTB_SIZE_MB * 1M, CONFIG_TTB_SIZE_MB * 1M)
+#else
+	/* Avoid a 32-bit linker overflow at the exclusive 0x100000000 end. */
+	TTB(0xffc00000, 0x3fffff)
+#endif
 }
